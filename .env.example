NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://locman:locman_dev@localhost:5432/ai_locman
REDIS_URL=redis://localhost:6379
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openrouter/auto
APP_PUBLIC_URL=http://localhost:8080
ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Single-user backend access password (minimum 12 characters; use a unique random value)
LOCMAN_ACCESS_PASSWORD=
LOCMAN_OWNER_ID=local-dev-user

# GitHub App integration (installation restricted to repositories selected in GitHub)
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
# Keep the PEM private key on the backend only; for .env, use literal \n between PEM lines.
GITHUB_APP_PRIVATE_KEY=
